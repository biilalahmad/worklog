---
import SiteLayout from '../layouts/SiteLayout.astro';
const features = [
  { n: '01', title: 'Clients and projects', body: 'Keep client contact details, project context, invoice amounts and payment status connected in one place.' },
  { n: '02', title: 'Work log and time', body: 'Record the kind of work you did, delivery status, notes, tasks completed and hours worked. Use a timer or enter time manually.' },
  { n: '03', title: 'Invoices and online sharing', body: 'Create project invoices, download a polished PDF or share a private, read-only invoice link with your client.' },
  { n: '04', title: 'Income and expenses', body: 'Log payments and spending in their original currencies, then review clear summaries and downloadable reports.' },
  { n: '05', title: 'Reminders', body: 'Set one-time or repeating reminders for the things you don’t want to forget.' },
  { n: '06', title: 'Optional gym and diet', body: 'If it helps your routine, track workouts, personal routines, meals and saved foods. Keep it off if it’s not for you.' },
];
---
<SiteLayout title="WorkLog features — a work log for freelancers" description="Explore WorkLog features for client and project organization, work history, time, invoices, finance, reminders and optional wellness tracking.">
  <section class="page-hero"><div class="container narrow"><span class="eyebrow">WHAT YOU CAN KEEP TRACK OF</span><h1>Your work and the details around it.</h1><p class="hero-lede">A useful work log should fit the way you already work. Start with clients and projects, then add the records that help you stay organized.</p><a class="button button-primary" href="/app/#/signup">Try WorkLog <span aria-hidden="true">→</span></a></div></section>
  <section class="section section-space"><div class="container feature-list">{features.map((feature) => <article class="feature-row"><span class="feature-index">{feature.n}</span><div><h2>{feature.title}</h2><p>{feature.body}</p></div></article>)}</div></section>
  <section class="section solution-section"><div class="container section-heading-row"><div><span class="eyebrow">SIMPLE BY DESIGN</span><h2>Your records stay connected.</h2></div><p>WorkLog is a personal workspace—not a complicated project-management system. Keep what matters, and find it when it’s useful.</p></div></section>
  <section class="section final-cta-section"><div class="container final-cta"><div><span class="eyebrow eyebrow-light">YOUR WORK, IN ONE PLACE</span><h2>Start your WorkLog.</h2><p>Build a clearer record of your freelance work, one entry at a time.</p></div><div class="final-cta-actions"><a class="button button-white" href="/app/#/signup">Create your account <span aria-hidden="true">→</span></a></div></div></section>
</SiteLayout>

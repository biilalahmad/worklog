---
import PageClouds from '../components/PageClouds.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { readFile } from 'node:fs/promises';

const releasesApiUrl = 'https://api.github.com/repos/biilalahmad/worklog/releases?per_page=10';
let apkUrl = 'https://github.com/biilalahmad/worklog/releases/latest/download/WorkLog.apk';
let releaseInfo: [string, string][] = [
  ['Version', '0.5.2'],
  ['APK size', '70.7 MB'],
  ['Minimum Android', 'Android 7.0+'],
  ['Released', '18 October 2026'],
];
let releaseHistory = [
  { version: '0.5.2', build: '3', date: '18 Oct 2026', datetime: '2026-10-18', href: 'https://github.com/biilalahmad/worklog/releases/tag/v0.5.2', current: true },
  { version: '0.5.1', build: '2', date: '12 Oct 2026', datetime: '2026-10-12', href: 'https://github.com/biilalahmad/worklog/releases/tag/v0.5.1', current: false },
  { version: '0.5.0', build: '1', date: '11 Oct 2026', datetime: '2026-10-11', href: 'https://github.com/biilalahmad/worklog/releases/tag/v0.5.0', current: false },
];

try {
  const appManifest = await readFile(new URL('../../../pubspec.yaml', import.meta.url), 'utf8');
  const appVersion = appManifest.match(/^version:\s*(\d+\.\d+\.\d+)\+(\d+)/m);
  const currentAppBuild = appVersion ? { version: appVersion[1], build: appVersion[2] } : null;
  const response = await fetch(releasesApiUrl, {
    headers: { Accept: 'application/vnd.github+json' },
    signal: AbortSignal.timeout(5000),
  });
  if (!response.ok) throw new Error(`GitHub Releases returned ${response.status}`);
  const published = (await response.json()).filter((release) => !release.draft && !release.prerelease);
  const withApk = published.map((release) => ({
    release,
    apk: release.assets?.find((asset) => asset.name.toLowerCase().endsWith('.apk')),
  })).filter(({ apk }) => apk);
  const latest = withApk[0];
  if (latest) {
    const version = latest.release.tag_name.replace(/^v/i, '');
    const publishedAt = new Date(latest.release.published_at);
    const dateLong = publishedAt.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
    apkUrl = latest.apk.browser_download_url;
    releaseInfo = [
      ['Version', version],
      ['APK size', `${(latest.apk.size / (1024 * 1024)).toFixed(1)} MB`],
      ['Minimum Android', 'Android 7.0+'],
      ['Released', dateLong],
    ];
    const knownBuilds: Record<string, string> = { '0.5.0': '1', '0.5.1': '2', '0.5.2': '3' };
    releaseHistory = withApk.slice(0, 3).map(({ release }) => {
      const releaseVersion = release.tag_name.replace(/^v/i, '');
      const releaseDate = new Date(release.published_at);
      const notesBuild = `${release.name ?? ''}\n${release.body ?? ''}`.match(/\bbuild(?:\s*(?:number|code))?\s*[:#-]?\s*(\d+)\b/i)?.[1];
      const build = notesBuild ?? (currentAppBuild?.version === releaseVersion ? currentAppBuild.build : knownBuilds[releaseVersion]) ?? '—';
      return {
        version: releaseVersion,
        build,
        date: releaseDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' }),
        datetime: releaseDate.toISOString().slice(0, 10),
        href: release.html_url,
        current: release.id === latest.release.id,
      };
    });
  }
} catch {
  // Keep the last verified public-release details if GitHub is unavailable during this build.
}
---
<SiteLayout title="Download WorkLog for Android" description="Download WorkLog for Android from the official GitHub release and find simple installation and update instructions.">
  <section class="page-hero download-hero">
    <PageClouds />
    <div class="container narrow">
      <span class="eyebrow">GET STARTED WITH WORKLOG</span>
      <h1>Your freelance work log, ready for Android.</h1>
      <p class="hero-lede">Download the Android app from the official WorkLog release. Keep your clients, projects, work history, invoices and finances close at hand.</p>
      <a class="button button-primary" href={apkUrl}>Download APK <span aria-hidden="true">↓</span></a>
    </div>
  </section>
  <section class="section section-space download-details-section">
    <div class="container download-layout">
      <div>
        <span class="eyebrow">RELEASE DETAILS</span>
        <h2>Before you install</h2>
        <p class="section-lede">Check the release information and make sure you are downloading WorkLog from this official page.</p>
        <dl class="download-info-grid">
          {releaseInfo.map(([label, value]) => <div class="download-info-item"><dt>{label}</dt><dd>{value}</dd></div>)}
        </dl>
      </div>
      <aside class="install-panel">
        <span class="eyebrow">INSTALL IN A FEW STEPS</span>
        <ol class="install-steps">
          <li class="install-step"><p>Tap <strong>Download APK</strong> above and wait for the file to finish downloading.</p></li>
          <li class="install-step"><p>If Android asks, allow your browser to <strong>install unknown apps</strong>. You can turn this permission off again afterwards.</p></li>
          <li class="install-step"><p>Open the downloaded APK file and tap <strong>Install</strong>.</p></li>
          <li class="install-step"><p>Open WorkLog and sign in. New accounts still need email verification and an internet connection.</p></li>
        </ol>
        <p class="install-note"><strong>Android security note</strong>Your browser may warn that the app is not from Google Play. Only install the APK downloaded from this official WorkLog page and the linked GitHub release.</p>
      </aside>
    </div>
  </section>
  <section class="section section-space release-history-section" aria-labelledby="release-history-title">
    <div class="container narrow">
      <span class="eyebrow">VERSION HISTORY</span>
      <h2 id="release-history-title">WorkLog releases.</h2>
      <p class="section-lede">The latest Android version and previous public releases.</p>
      <ol class="release-history-list">
        {releaseHistory.map((release) => (
          <li class="release-history-item">
            <div class="release-history-version"><strong>v{release.version}</strong>{release.current && <span class="release-current-badge">Latest</span>}</div>
            <span class="release-history-build">Build {release.build}</span>
            <time class="release-history-date" datetime={release.datetime}>{release.date}</time>
            <a class="release-history-link" href={release.href}>Release details <span aria-hidden="true">↗</span></a>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <section class="section solution-section"><div class="container narrow"><span class="eyebrow">UPDATING WORKLOG</span><h2>Keep your existing app and data.</h2><p>When a newer release is available, download it and install it over the current WorkLog app. You should not need to uninstall first as long as the package identity and signing key remain the same. Always keep a backup of your important records.</p></div></section>
</SiteLayout>

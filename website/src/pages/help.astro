---
import SiteLayout from '../layouts/SiteLayout.astro';
const questions = [
  ['Who is WorkLog for?', 'WorkLog is a personal work log for freelancers across different fields. Use it to keep track of clients, projects, work delivered, time, invoices, income, expenses and reminders. The gym and diet tools are optional.'],
  ['How do I finish creating my account?', 'After signing up, check your email and follow the account verification link. If it does not arrive, check spam and use the resend option on the check-email screen.'],
  ['Can I share an invoice without sending a PDF?', 'Yes. In a project’s invoice area, choose the online share action to copy a private link. The link opens a read-only invoice page; anyone with the link can view it, so share it with the intended recipient.'],
  ['Can I download a PDF invoice?', 'Yes. Use the PDF invoice action on a project. The online invoice link is an additional option, not a replacement for the PDF.'],
  ['How do Android app updates work?', 'For direct APK releases, download the newer version from the Download page and install it over the current app. You should not need to uninstall when the package identity and signing key match.'],
  ['Do I have to use the gym and diet features?', 'No. Gym and diet tracking is optional. WorkLog is designed to help you keep a record of your freelance work first.'],
];
---
<SiteLayout title="Help and frequently asked questions — WorkLog" description="Answers about WorkLog accounts, invoices, app updates, work logs and optional wellness features.">
  <section class="page-hero"><div class="container narrow"><span class="eyebrow">HELP &amp; FAQ</span><h1>Quick answers for using WorkLog.</h1><p class="hero-lede">Need something else? <a class="inline-link" href="/support/">Contact WorkLog support</a>.</p></div></section>
  <section class="section section-space"><div class="container faq-list">{questions.map(([question, answer]) => <details class="faq-item"><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
  <section class="section solution-section"><div class="container narrow"><h2>Still need a hand?</h2><p>Send us a message and include the email address associated with your WorkLog account. Don’t include passwords or security codes.</p><a class="button button-primary" href="/support/">Contact support <span aria-hidden="true">→</span></a></div></section>
</SiteLayout>
